{
  "name": "sqxy-arclab-site",
  "version": "1.0.0",
  "private": true,
  "hexo": {
    "version": "8.1.2"
  },
  "description": "ArcLab 弧光实验室官网与学习中心",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
